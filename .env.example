# Variables du site Leadvice. Copier en .env pour le développement local.
# En production : Cloudflare Pages > Paramètres > Variables et secrets (les secrets ne sont jamais commités).

# ---------- Navigateur (préfixe PUBLIC_, lues au build) ----------
# Google Tag Manager (GA4 et Google Ads passent par GTM). Vide : aucun script de mesure.
PUBLIC_GTM_ID=
# Pixel Meta. Vide : pas de pixel.
PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag. Vide : pas de balise.
PUBLIC_LINKEDIN_PARTNER_ID=
# Cloudflare Turnstile, clé publique. Vide : pas de widget anti-robots.
PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Serveur (Pages Functions et Worker des rappels) ----------
# Adresse publique du site, utilisée dans les e-mails et les liens de gestion.
SITE_URL=https://leadvice.org
SITE_VERSION=b7
# Resend : envoi des e-mails (confirmation, notification interne, rappels).
RESEND_API_KEY=
MAIL_FROM=Leadvice <diagnostic@leadvice.org>
MAIL_TO=contact@leadvice.org
# Turnstile, clé secrète.
TURNSTILE_SECRET_KEY=
# Google Agenda : JSON complet du compte de service (sur une ligne), agenda à lire et à remplir,
# utilisateur Google Workspace représenté (délégation au niveau du domaine) pour inviter et créer le lien Meet.
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_CALENDAR_ID=
GOOGLE_IMPERSONATE=
# API Conversions de Meta (avec PUBLIC_META_PIXEL_ID).
META_CAPI_TOKEN=
# « 1 » pour envoyer les événements serveur même sans accord publicité (à valider avec la CNDP avant).
CAPI_SANS_CONSENTEMENT=
# Cloudflare Access qui protège /admin/ et /api/admin/.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
