---
/* Gabarit commun des pages leviers : réponse directe, scène, ce que nous faisons, est-ce pour vous,
   comment nous travaillons, pour aller plus loin, FAQ, expertise suivante, diagnostic. */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import SceneSection from './SceneSection.astro';
import ReadMore from './ReadMore.astro';
import Faq from './Faq.astro';
import LeverRows from './LeverRows.astro';
import CtaBand from './CtaBand.astro';
import { site, type Data } from '../lib/content';
import { faqPage, service } from '../lib/schema';
import '../styles/pages/levier.css';
interface Props { d: Data; path: string }
const { d, path } = Astro.props;
const l = await site('leviers');
const crumb = [{ name: 'Accueil', url: '/' }, { name: 'Expertises', url: '/expertises/' }, { name: d.fil, url: path }];
const speeds = ['-0.12', '0.00', '0.12'];
---
<Base title={d.seo.title} description={d.seo.description} og={d.seo.og} section="exp" crumb={crumb} jsonld={[service(d.service, d.reponse, path), faqPage(d.faq.questions)]}>
  <PageHero crumb={crumb} h1={d.h1} lead={d.reponse} cta />
  <SceneSection nom={d.scene.nom} len={d.scene.len} aria={d.scene.aria} legende={d.scene.legende} etapes={d.scene.etapes} />

  <section class="wrap sec">
    <div class="split">
      <div class="stick">
        <h2 data-rise>{d.faisons.titre}</h2>
        {d.faisons.intro && <p class="lead mt-s">{d.faisons.intro}</p>}
      </div>
      <div class="items">
        {(d.faisons.items as Data[]).map((it) => <div class="item"><h3>{it.titre}</h3><p set:html={it.texte} /></div>)}
      </div>
    </div>
  </section>

  <slot name="after-faisons" />

  <section class="wrap sec sec-top0">
    <h2 data-rise class="h-gap">{d.pour_vous.titre}</h2>
    <div class="sits">
      {(d.pour_vous.situations as string[]).map((x, i) => <div class="sit" data-speed={speeds[i % 3]}><p set:html={x} /></div>)}
    </div>
  </section>

  <section class="wrap sec sec-top0">
    <h2 data-rise class="h-gap-s">{d.comment.titre}</h2>
    <p class="big-text" data-light>{d.comment.texte}</p>
  </section>

  <slot name="after-comment" />

  <ReadMore slugs={d.lire} />
  <Faq titre={d.faq.titre} questions={d.faq.questions} />

  <section class="wrap sec sec-top0">
    <span class="legend">{l.commun.suivante}</span>
    <LeverRows keys={[d.suivante]} class="mt-s" />
  </section>

  <CtaBand titre={d.cloture.titre} texte={d.cloture.texte} />
</Base>
