---
/* Fil d'Ariane visible (pages de niveau 2) ; la barre fixée en haut le reprend au défilement. */
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
const last = items.length - 1;
---
<nav class="crumb" aria-label="Fil d'Ariane">
  {items.map((it, i) => i < last
    ? <Fragment><a href={it.url}>{it.name}</a><span aria-hidden="true">/</span></Fragment>
    : <span aria-current="page">{it.name}</span>)}
</nav>
