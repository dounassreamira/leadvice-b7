---
/* Secteurs en rangées (et non en trois cartes) : chaque rangée porte la vignette de sa scène,
   la façade (immobilier), le dossier qui circule (B2B), le colis (e-commerce). */
import Icon from './Icon.astro';
import type { Data } from '../lib/content';
interface Props { liste: Data[]; lien: string }
const { liste } = Astro.props;
const V: Record<string, string> = {
  immobilier: '<rect x="18" y="8" width="36" height="58" rx="2" fill="#1C1640"/><g fill="#7B61FF"><rect x="24" y="16" width="8" height="7"/><rect x="40" y="28" width="8" height="7"/></g><g fill="#3A3170"><rect x="40" y="16" width="8" height="7"/><rect x="24" y="28" width="8" height="7"/><rect x="24" y="40" width="8" height="7"/><rect x="40" y="52" width="8" height="7"/></g><rect x="40" y="40" width="8" height="7" fill="#FFC93C"/><rect x="24" y="52" width="8" height="7" fill="#FF7A59"/>',
  b2b: '<path d="M14 26 h16 l4 4 h24 v28 h-44 z" fill="#7B61FF"/><rect x="20" y="36" width="26" height="3" rx="1.5" fill="#fff"/><rect x="20" y="42" width="18" height="3" rx="1.5" fill="#fff" opacity=".7"/><g transform="translate(52 22) rotate(8)"><rect x="-14" y="-7" width="28" height="14" rx="2" fill="#FFF4EF" stroke="#C2410C" stroke-width="1.4"/><path d="M-8 1 c3 -4 5 3 8 -1 s4 3 8 0" stroke="#C2410C" stroke-width="1.2" fill="none"/></g>',
  'e-commerce': '<rect x="14" y="26" width="44" height="34" rx="2" fill="#D9B38C" stroke="#9C7A55"/><rect x="33" y="26" width="6" height="34" fill="#C79E74"/><rect x="42" y="44" width="12" height="9" rx="1" fill="#fff"/><g transform="translate(50 18) rotate(-8)"><rect x="-15" y="-7" width="30" height="14" rx="2" fill="#FFF4EF" stroke="#C2410C" stroke-width="1.4"/><path d="M-9 0 l4 4 l9 -8" stroke="#C2410C" stroke-width="1.6" fill="none"/></g>',
};
const key = (u: string): string => u.split('/').filter(Boolean).pop() ?? '';
---
<div class="rows rows-s">
  {liste.map((x) => (
    <a class="row" href={x.url}>
      <h3><svg viewBox="0 0 72 72" aria-hidden="true" set:html={V[key(x.url)] ?? ''} />{x.nom}</h3>
      <p>{x.texte}</p>
      <span class="go" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  ))}
</div>
<style>
  .rows-s .row { padding: 26px 0; }
  .rows-s .row :is(h2, h3) { font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.5rem); }
  .rows-s .row h3 svg { width: 64px; height: 64px; flex: none; }
</style>
