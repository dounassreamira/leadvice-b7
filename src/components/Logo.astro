---
/* Logo Leadvice vectorisé à partir de assets-wix/logo-leadvice.png : carré violet #301781, L blanc. */
interface Props { label: string; href?: string; current?: boolean }
const { label, href = '/', current = false } = Astro.props;
---
<a class="logo" href={href} aria-label={label} aria-current={current ? 'page' : undefined}>
  <svg viewBox="0 0 100 100" aria-hidden="true"><rect class="lm-bg" width="100" height="100" rx="2"/><path d="M29.7 17.1h17.1v51.4h28v13.5H29.7z" fill="#fff"/></svg>
  <span aria-hidden="true">LEADVICE</span>
</a>
