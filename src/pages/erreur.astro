---
/* Page d'erreur générique (400, 403, 405, 429, 500, 503), même scène que la 404. Le code vient de ?code=. */
import Base from '../layouts/Base.astro';
import { page, site, sceneLabels, type Data } from '../lib/content';

const d = await page('erreur');
const s = await site();
const labels = await sceneLabels('lost');
const def = (d.codes as Record<string, Data>)['500']!;
const lab = JSON.stringify({ ...JSON.parse(labels), code: '500' });
---
<Base title={d.seo.title} description={d.seo.description} og={d.seo.og} page="404" noindex thread={false} fab={false}>
  <section class="e404" data-err={JSON.stringify(d.codes)}>
    <div class="e404-cv" data-scene="lost" data-static data-loop data-labels={lab} aria-hidden="true"><canvas></canvas></div>
    <script is:inline>(function(){var c=new URLSearchParams(location.search).get('code');if(!/^[45]\d\d$/.test(c||''))return;var e=document.currentScript.previousElementSibling;var l=JSON.parse(e.dataset.labels||'{}');l.code=c;e.dataset.labels=JSON.stringify(l)})();</script>
    <div class="wrap e404-tx">
      <p class="legend" data-e="legende">{def.legende}</p>
      <h1 data-e="h1">{def.h1}</h1>
      <p class="lead" data-e="texte">{def.texte}</p>
      <div class="acts">
        <button type="button" class="btn btn-main" data-back>{d.retour}</button>
        <a class="btn btn-ghost" href="/">{d.accueil}</a>
        <a class="tlink" href="/diagnostic/">{s.cta.principal}</a>
        <a class="tlink" href="mailto:contact@leadvice.org">{d.contact}</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const sec = document.querySelector<HTMLElement>('[data-err]');
  const code = new URLSearchParams(location.search).get('code') ?? '';
  const all = JSON.parse(sec?.dataset.err ?? '{}') as Record<string, Record<string, string>>;
  const t = all[code];
  if (t) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-e]')) el.textContent = t[el.dataset.e!] ?? el.textContent;
    document.title = `${t.legende} | Leadvice`;
  }
  document.querySelector('[data-back]')?.addEventListener('click', () => (history.length > 1 ? history.back() : location.assign('/')));
</script>
<style>
  .e404 { position: relative; min-height: 100svh; display: flex; align-items: flex-end; padding-bottom: clamp(48px, 8vh, 96px); overflow: hidden; }
  .e404-cv { position: absolute; inset: 0; }
  .e404-cv canvas { width: 100%; height: 100%; display: block; }
  .e404-tx { position: relative; max-width: 760px; margin-left: 0; }
  .e404-tx h1 { font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.8rem); line-height: 1; margin: 10px 0 18px; }
  .e404-tx .acts { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: center; margin-top: 28px; }
  .e404-tx .lead { max-width: 52ch; }
  @media (max-width: 760px) { .e404-cv { bottom: 41%; } }
</style>
