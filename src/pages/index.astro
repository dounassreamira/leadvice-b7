---
/* Accueil « Parcours » : un plan-séquence suit un prospect de l'annonce au rendez-vous,
   puis un fil violet descend la page et relie chaque section. Textes : src/content/pages/accueil.yaml. */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import { page, site, sceneLabels, type Data } from '../lib/content';
import { logo, portrait } from '../lib/images';
import { faqPage } from '../lib/schema';
import '../styles/pages/accueil.css';

const p = await page('accueil');
const s = await site();
const clients = (await site('clients')).liste as Data[];
const chiffres = await site('chiffres');
const fondatrices = (await site('fondatrices')).liste as Data[];
const moneyLabels = await sceneLabels('money');
const o = p.ouverture, e = o.ecrans, pe = p.pertes, x = p.expertises;
const sc = o.scenes as [Data, Data, Data, Data, Data];
const XS = [0, 58, 118, 170, 222];
const XSC: Record<string, string> = { strat: 'knot', crea: 'angles', acq: 'target', pil: 'dial' };
const XLAB: Record<string, string> = Object.fromEntries(await Promise.all(Object.entries(XSC).map(async ([k, v]) => [k, await sceneLabels(v)] as const)));
---
<Base title={p.seo.title} description={p.seo.description} og={p.seo.og} page="home" thread={false} jsonld={[faqPage(p.faq.questions)]} bodyClass="pc-home">

  <section class="pc-story" id="top" aria-label={o.aria} data-pc-story data-hide-fab>
    <div class="pc-stage" data-pc-stage>
      <div class="pc-aura" aria-hidden="true"></div>
      <div class="pc-delay" aria-hidden="true" data-pc-delay data-steps={JSON.stringify(o.delai)}><b></b><small></small></div>
      <div class="pc-world" data-pc-world>
        <svg class="pc-line" aria-hidden="true" data-pc-line><path class="ghost" /><path class="trail" /></svg>

        <div class="pc-scene" style="--i:0">
          <div class="pc-cap">
            <h1>{sc[0].titre}</h1>
            <p>{sc[0].texte}</p>
            <div class="pc-act"><a class="btn btn-main" href="/diagnostic/">{s.cta.principal}</a><span class="pc-note">{o.note}</span><a class="pc-skip" href="#preuves">{o.passer}</a></div>
          </div>
          <div class="pc-obj pc-phone" aria-hidden="true"><div class="pc-screen"><div class="pc-feed" data-pc-feed>
            <div class="pc-post"></div><div class="pc-post s"></div>
            <div class="pc-ad" data-pc-anchor="0"><div class="h"><i></i><div>{e.marque}<br /><small>{e.sponsorise}</small></div></div><div class="img"></div><div class="t">{e.annonce_titre}<span>{e.annonce_sous}</span></div></div>
            <div class="pc-post"></div><div class="pc-post s"></div>
          </div></div></div>
        </div>

        <div class="pc-scene" style="--i:1">
          <div class="pc-cap"><h2>{sc[1].titre}</h2><p>{sc[1].texte}</p><div class="pc-act"><a class="pc-skip" href="#preuves">{o.passer}</a></div></div>
          <div class="pc-obj pc-lp" aria-hidden="true"><div class="bar"><i></i><i></i><i></i><span>{e.site}</span></div><div class="hero"></div><div class="body"><h3>{e.page_titre}</h3><p>{e.page_texte}</p><span class="pill" data-pc-anchor="1">{e.page_bouton}</span></div></div>
        </div>

        <div class="pc-scene" style="--i:2">
          <div class="pc-cap"><h2>{sc[2].titre}</h2><p>{sc[2].texte}</p><div class="pc-act"><a class="pc-skip" href="#preuves">{o.passer}</a></div></div>
          <div class="pc-obj pc-form" aria-hidden="true"><h3>{e.form_titre}</h3>
            {(e.champs as Data[]).map((c) => <div class="field"><small>{c.label}</small><b data-type={c.valeur}></b></div>)}
            <div class="send" data-pc-anchor="2" data-pc-send>{e.form_bouton}</div>
          </div>
        </div>

        <div class="pc-scene" style="--i:3">
          <div class="pc-cap"><h2>{sc[3].titre}</h2><p>{sc[3].texte}</p><div class="pc-act"><a class="pc-skip" href="#preuves">{o.passer}</a></div></div>
          <div class="pc-obj pc-phone rep" aria-hidden="true"><div class="pc-screen">
            <div class="notif" data-pc-anchor="3" data-pc-notif><b>{e.marque}</b>{e.message}</div>
            <div class="call" data-pc-call><div class="chips">{(e.creneaux as string[]).map((c) => <span>{c}</span>)}</div><div class="me">{e.reponse}</div></div>
          </div></div>
        </div>

        <div class="pc-scene" style="--i:4">
          <div class="pc-cap"><h2>{sc[4].titre}</h2><p>{sc[4].texte}</p><div class="pc-act"><a class="btn btn-main" href="/diagnostic/">{s.cta.principal}</a></div></div>
          <div class="pc-obj pc-cal" aria-hidden="true"><div class="m">{e.jour}</div>
            <div class="days">{(e.jours as string[]).map((j, i) => <span class={i === 5 ? 'hit' : undefined} data-pc-anchor={i === 5 ? '4' : undefined}>{j}</span>)}</div>
            <div class="slot">{e.agenda}</div>
            <div class="signed" data-pc-signed>{e.signe}</div>
          </div>
        </div>
      </div>
      <div class="pc-dot" aria-hidden="true" data-pc-dot></div>
    </div>
  </section>

  <div class="pc-flow" data-pc-flow>
    <svg class="pc-rail" aria-hidden="true" data-pc-rail><path class="g" /><path class="l" /></svg>
    <div class="pc-rail-dot" aria-hidden="true" data-pc-rail-dot></div>

    <section class="wrap pc-sec" id="preuves" data-stop>
      <h2>{p.preuves.titre}</h2>
      <p class="lead">{p.preuves.texte}</p>
      <div class="pc-proof">
        <div class="pc-big"><span class="num" data-count={p.preuves.chiffre}>{p.preuves.chiffre_affiche}</span><small>{p.preuves.legende}</small></div>
        <div class="pc-logos frost" aria-label={p.preuves.logos_aria} data-pc-logos>
          {clients.map((c) => <div><Image src={logo(c.logo)} alt={c.nom} width={220} class="logo-img" loading="lazy" /></div>)}
        </div>
      </div>
    </section>

    <section class="wrap pc-sec" id="pertes" data-stop>
      <h2>{pe.titre}</h2>
      <p class="lead">{pe.texte}</p>
      <div class="pc-breaks">
        <div class="pc-brk frost" data-brk="call">
          <svg viewBox="0 0 320 170" aria-hidden="true">
            <path d="M30 126 L290 126" stroke="#DEDAE8" stroke-width="2" stroke-dasharray="3 6" />
            <path class="tie" d="M30 126 L290 126" />
            <circle cx="30" cy="126" r="6" fill="#7B61FF" /><text class="sv-b" x="30" y="150" text-anchor="middle">{pe.rappel.dessin.heure}</text><text class="sv-t" x="30" y="164" text-anchor="middle">{pe.rappel.dessin.demande}</text>
            <circle class="t1-dot" cx="290" cy="126" r="6" fill="#B4A6FF" /><text class="sv-b t1-call" x="296" y="150" text-anchor="end" data-a={pe.rappel.dessin.avant} data-b={pe.rappel.dessin.apres}>{pe.rappel.dessin.avant}</text><text class="sv-t" x="296" y="164" text-anchor="end">{pe.rappel.dessin.appel}</text>
            <text class="sv-t t1-gap" x="160" y="116" text-anchor="middle" data-a={pe.rappel.dessin.trou} data-b={pe.rappel.dessin.vite}>{pe.rappel.dessin.trou}</text>
            <g class="t1-bub" opacity="0"><rect x="60" y="18" width="180" height="52" rx="12" fill="#fff" stroke="#B4A6FF" /><text class="sv-t" x="74" y="38">{pe.rappel.dessin.bulle_titre}</text><text class="sv-b" x="74" y="56">{pe.rappel.dessin.bulle}</text></g>
            <g class="t1-p"><circle cx="286" cy="52" r="11" fill="#FF7A59" /><path d="M266 88 a20 17 0 0 1 40 0 z" fill="#FF7A59" /></g>
            <text class="sv-k t1-state" x="286" y="24" text-anchor="middle" data-a={pe.rappel.dessin.messagerie} data-b={pe.rappel.dessin.decroche}>{pe.rappel.dessin.messagerie}</text>
          </svg>
          <div><q>{pe.rappel.phrase}</q><p>{pe.rappel.texte}</p><span class="fix">{pe.rappel.solution}</span></div>
        </div>

        <div class="pc-brk frost" data-brk="attr">
          <svg viewBox="0 0 320 178" aria-hidden="true" data-at={JSON.stringify({ un: pe.attribution.dessin.vente, plus: pe.attribution.dessin.ventes })}>
            {(pe.attribution.dessin.annonces as string[]).map((a, i) => (
              <g class="t2-ad" transform={`translate(${12 + i * 104} 10)`}>
                <rect width="88" height="96" rx="7" fill="#fff" stroke="#DEDAE8" />
                <circle cx="12" cy="12" r="5" fill="#B4A6FF" /><rect x="22" y="9" width="40" height="6" rx="3" fill="#E6E1EE" />
                <rect class="t2-img" x="8" y="24" width="72" height="40" rx="4" fill="#EFEBF8" />
                <text class="sv-b" x="8" y="80">{a}</text>
                <text class="sv-t t2-n" x="8" y="91">0 {pe.attribution.dessin.ventes}</text>
                <g class="t2-cut" opacity="0"><rect x="14" y="36" width="60" height="18" rx="3" fill="#fff" stroke="#8A8499" /><text class="sv-t" x="44" y="49" text-anchor="middle">{pe.attribution.dessin.coupee}</text></g>
                <rect x="0" y="104" width="88" height="6" rx="3" fill="#EFEBF8" /><rect class="t2-bar" x="0" y="104" width="44" height="6" rx="3" fill="#7B61FF" />
              </g>
            ))}
            <text class="sv-t" x="12" y="134">{pe.attribution.dessin.budget}</text>
            <g class="t2-st">{[0, 1, 2, 3].map(() => <g opacity="0"><rect x="-26" y="-10" width="52" height="20" rx="3" fill="#FFF4EF" stroke="#C2410C" stroke-width="1.4" /><text x="0" y="4" text-anchor="middle" class="sv-st">{pe.attribution.dessin.signe}</text></g>)}</g>
            <text class="sv-k t2-res" x="12" y="160" style="font-size:14px">{pe.attribution.dessin.resultat}</text>
          </svg>
          <div><q>{pe.attribution.phrase}</q><p>{pe.attribution.texte}</p><span class="fix">{pe.attribution.solution}</span></div>
        </div>

        <div class="pc-brk frost" data-brk="lang">
          <svg viewBox="0 0 320 170" aria-hidden="true">
            <g class="t3-a"><rect x="10" y="20" width="132" height="54" rx="10" fill="#fff" stroke="#DEDAE8" /><text class="sv-t" x="22" y="40">{pe.langage.dessin.agence}</text><text class="sv-b" x="22" y="60" style="font-size:15px">{pe.langage.dessin.clics}</text></g>
            <g class="t3-b"><rect x="178" y="20" width="132" height="54" rx="10" fill="#fff" stroke="#DEDAE8" /><text class="sv-t" x="190" y="40">{pe.langage.dessin.direction}</text><text class="sv-b" x="190" y="60" style="font-size:15px">{pe.langage.dessin.question}</text></g>
            <g class="t3-tab" opacity="0">
              <rect x="10" y="96" width="300" height="56" rx="6" fill="#fff" stroke="#B4A6FF" />
              {(pe.langage.dessin.colonnes as string[]).map((c, i) => <text class="sv-t" x={30 + (XS[i] ?? 0)} y="116">{c}</text>)}
              {(pe.langage.dessin.valeurs as string[]).map((v, i) => <text class="sv-b" x={30 + (XS[i] ?? 0)} y="138">{v}</text>)}
            </g>
            <path class="tie" d="M76 76 C 76 90, 120 92, 160 94 C 200 92, 244 90, 244 76" />
            <text class="sv-t" x="310" y="166" text-anchor="end">{pe.langage.dessin.exemple}</text>
          </svg>
          <div><q>{pe.langage.phrase}</q><p>{pe.langage.texte}</p><span class="fix">{pe.langage.solution}</span></div>
        </div>
      </div>
    </section>

    <section class="wrap pc-sec" id="expertises" data-stop>
      <h2>{x.titre}</h2>
      <p class="lead">{x.texte}</p>
      <div class="pc-exp4">
        {(x.liste as Data[]).map((it) => (
          <a class="pc-xc frost" href={it.url} data-x={it.cle}>
            <canvas class="pc-xcv" data-scene={XSC[it.cle]} data-mini data-p="0" data-labels={XLAB[it.cle]} aria-hidden="true"></canvas>
            <span class="when">{it.moment}</span><h3>{it.titre}</h3><p>{it.texte}</p><span class="tlink">{it.lien}</span>
          </a>
        ))}
      </div>
      <p class="pc-side frost">{x.sites} <a class="tlink" href="/expertises/sites-web/">{x.sites_lien}</a></p>
    </section>

    <section class="wrap pc-sec" id="systeme" data-stop>
      <div class="pc-sys">
        <div><h2>{p.systeme.titre}</h2><p class="lead">{p.systeme.texte}</p></div>
        <svg class="pc-sysv" viewBox="0 0 360 320" role="img" aria-label={p.systeme.aria} data-pc-sys data-pieces={JSON.stringify(p.systeme.pieces)}>
          <g class="sy-l" stroke="#B4A6FF" stroke-width="1.5" fill="none"></g>
          <circle cx="180" cy="160" r="46" fill="#130D33" />
          {(p.systeme.centre as string[]).map((t, i) => <text x="180" y={156 + i * 20} text-anchor="middle" class="sy-c">{t}</text>)}
          <g class="sy-n"></g>
        </svg>
      </div>
    </section>

    <section class="wrap pc-sec" id="pour-qui" data-stop>
      <h2>{p.pour_qui.titre}</h2>
      <p class="lead">{p.pour_qui.texte}</p>
      <ul class="pc-dep">
        {(p.pour_qui.departs as Data[]).map((x) => <li><h3>{x.situation}</h3><div><p>{x.reponse}</p><a class="tlink" href={x.url}>{x.lien}</a></div></li>)}
      </ul>
      <p class="pc-conseil frost">{p.pour_qui.conseil}</p>
      <p class="pc-secteurs">{p.pour_qui.secteurs_intro} {(p.pour_qui.secteurs as Data[]).map((l, i) => <Fragment>{i > 0 && ', '}<a class="tlink" href={l.url}>{l.libelle}</a></Fragment>)}.</p>
    </section>

    <section class="scene flow pc-money" id="dirham" data-stop data-scene="money" data-len="320" aria-label={p.dirham.aria} data-labels={moneyLabels}>
      <canvas aria-hidden="true"></canvas>
      <div class="tag"><h2>{p.dirham.titre}</h2><div class="scene-dots" aria-hidden="true">{(p.dirham.etapes as Data[]).map(() => <b></b>)}</div></div>
      <div class="cap" aria-live="polite">
        {(p.dirham.etapes as Data[]).map((et) => <p data-at={`${et.de}-${et.a}`}>{et.texte}</p>)}
      </div>
    </section>

    <section class="violet pc-night" id="chiffres" data-stop data-hide-fab>
      <div class="wrap pc-sec">
        <h2>{p.chiffres.titre}</h2>
        <p class="lead">{p.chiffres.texte}</p>
        <div class="pc-stats">
          {(chiffres.cabinet as Data[]).map((c) => <div class="pc-stat"><b class="num" data-count={c.compteur ?? undefined} data-pre={c.compteur ? c.prefixe : undefined}>{c.valeur}</b><span>{c.texte}</span></div>)}
        </div>
        <p class="small pc-fine">{chiffres.note}</p>
      </div>
    </section>

    <section class="wrap pc-sec" id="methode" data-stop>
      <h2>{p.methode.titre}</h2>
      <ol class="pc-steps" data-pc-steps>
        {(p.methode.etapes as Data[]).map((st, i) => <li class="frost"><span class="n">{i + 1}</span><div><h3>{st.titre}</h3><p>{st.texte}</p>{st.boucle && <span class="wk">{st.boucle}</span>}</div></li>)}
      </ol>
    </section>

    <section class="wrap pc-sec" id="diagnostic" data-stop>
      <div class="pc-diag">
        <div>
          <h2>{p.diagnostic.titre}</h2>
          <p class="lead">{p.diagnostic.texte}</p>
          <div class="pc-diag-cta"><a class="btn btn-main" href="/diagnostic/">{s.cta.principal}</a></div>
          <form class="pc-mail frost" data-pc-lead data-magnet="exemple-plan" data-ok={p.diagnostic.email_ok} data-err={p.diagnostic.email_erreur} novalidate>
            <label for="pc-em" class="sr-only">{p.diagnostic.email_label}</label>
            <input id="pc-em" name="email" type="email" placeholder={p.diagnostic.email_label} autocomplete="email" required />
            <input type="text" name="site" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
            <button type="submit" class="btn btn-ghost">{p.diagnostic.email_bouton}</button>
          </form>
          <p class="small pc-msg" role="status" data-pc-msg></p>
        </div>
        <div class="pc-doc" data-pc-doc>
          <div class="dh"><span>{p.diagnostic.doc.entete}</span><span>{p.diagnostic.doc.type}</span></div>
          <h3 data-t={p.diagnostic.doc.titre}>{p.diagnostic.doc.titre}</h3>
          <ol>{(p.diagnostic.doc.parties as Data[]).map((pa) => <li><div><b data-t={pa.titre}>{pa.titre}</b><span data-t={pa.texte}>{pa.texte}</span></div></li>)}</ol>
          <span class="stamp" data-pc-stamp>{p.diagnostic.doc.tampon}</span>
        </div>
      </div>
    </section>

    <section class="wrap pc-sec" id="ateliers" data-stop>
      <h2>{p.ateliers.titre}</h2>
      <p class="lead">{p.ateliers.texte}</p>
      <div class="pc-ws">
        {(p.ateliers.liste as Data[]).map((w) => (
          <a class="pc-wsc frost" href={w.url} data-w={w.cle}>
            <span class="k">{w.duree}</span><h3>{w.titre}</h3>
            {w.cle === 'camp' ? <svg viewBox="0 0 300 80" aria-hidden="true"><g class="wa-b"></g><path class="wa-l" fill="none" stroke="#FF7A59" stroke-width="2.5" stroke-linecap="round" /></svg>
              : <svg viewBox="0 0 300 80" aria-hidden="true"><rect x="80" y="4" width="140" height="74" rx="6" fill="#fff" stroke="#DEDAE8" /><g class="wp-b"><rect x="90" y="12" width="120" height="8" rx="2" fill="#B4A6FF" /><rect x="90" y="26" width="90" height="12" rx="2" fill="#16131F" /><rect x="90" y="44" width="120" height="14" rx="2" fill="#ECEAF3" /><rect x="90" y="63" width="60" height="9" rx="3" fill="#FF7A59" /></g></svg>}
            <p>{w.texte}</p><span class="tlink">{w.lien}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap pc-sec" id="cabinet" data-stop>
      <h2>{p.cabinet.titre}</h2>
      <p class="lead">{p.cabinet.texte}</p>
      <div class="pc-team">
        {fondatrices.map((f) => <div class="pc-pp frost"><Image src={portrait(f.photo)} alt={f.alt} width={720} loading="lazy" /><h3>{f.nom}</h3><p class="small">{f.role} {f.univers}</p></div>)}
      </div>
      <p style="margin-top:24px"><a class="tlink" href="/cabinet/">{p.cabinet.lien}</a></p>
    </section>

    <section class="wrap pc-sec" id="ressources" data-stop>
      <div class="pc-res frost">
        <div><h2>{p.ressources.titre}</h2><p class="lead">{p.ressources.texte}</p><p style="margin-top:22px"><a class="tlink" href="/ressources/">{p.ressources.lien}</a></p></div>
        <ul>{(p.ressources.liste as Data[]).map((r) => <li><i aria-hidden="true"></i><div><b>{r.titre}</b><span>{r.texte}</span></div></li>)}</ul>
      </div>
    </section>

    <div class="pc-faq" data-stop><Faq titre={p.faq.titre} questions={p.faq.questions} /></div>

    <section class="wrap pc-sec pc-end" id="fin" data-stop>
      <div class="pc-target" aria-hidden="true" data-pc-target></div>
      <h2>{p.fin.titre}</h2>
      <p class="lead">{p.fin.texte}</p>
      <a class="btn btn-main" href="/diagnostic/">{s.cta.principal}</a>
    </section>
  </div>

  <script>
    import '../scripts/accueil';
  </script>
</Base>
