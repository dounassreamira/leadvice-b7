---
/* Étude de cas Kettani Immobilier : contexte, programmes, problème, angle, résultats, exécution, enseignements. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import CopyButton from '../../components/CopyButton.astro';
import { page, dateFr, type Data } from '../../lib/content';
import '../../styles/pages/levier.css';

const d = await page('kettani');
const ins = await page('insights');
const crumb = [{ name: 'Accueil', url: '/' }, { name: 'Réalisations', url: '/realisations/' }, { name: d.fil, url: '/realisations/kettani-immobilier/' }];
const pub = new Date(d.publie);
const article = {
  '@type': 'Article',
  headline: d.h1,
  description: d.seo.description,
  datePublished: d.publie,
  dateModified: d.maj ?? d.publie,
  author: { '@type': 'Person', name: 'Amira Dounassre' },
  publisher: { '@id': 'https://leadvice.org/#org' },
  about: { '@type': 'Organization', name: 'Kettani Immobilier' },
  mainEntityOfPage: 'https://leadvice.org/realisations/kettani-immobilier/',
};
---
<Base title={d.seo.title} description={d.seo.description} og={d.seo.og} section="rea" crumb={crumb} jsonld={[article]} progress ogType="article">
  <PageHero crumb={crumb} h1={d.h1} lead={d.reponse}>
    <p class="small k-date">{ins.article.publie} <time datetime={d.publie}>{dateFr(pub)}</time> <CopyButton text="@url" label={ins.article.copier} done={ins.article.copie} /></p>
  </PageHero>

  <section class="wrap k-stats">
    <div class="stats">
      {(d.chiffres as Data[]).map((x) => <div class="stat"><b class="num" data-count={x.compteur} data-pre={x.prefixe}>{x.valeur}</b><span>{x.texte}</span></div>)}
    </div>
  </section>

  <section class="k-h" data-h aria-label={d.programmes.aria} tabindex="0">
    <div class="htrack">
      <div class="prog intro"><h2>{d.programmes.titre}</h2></div>
      {(d.programmes.liste as Data[]).map((p) => <div class="prog"><h3>{p.nom}</h3><p>{p.texte}</p></div>)}
    </div>
  </section>

  {(d.recit as Data[]).map((r) => (
    <section class="wrap sec k-recit">
      <div class="split"><h2 data-rise>{r.titre}</h2><p class="big-text k-big" data-light>{r.texte}</p></div>
    </section>
  ))}

  <section class="wrap sec">
    <div class="split">
      <div class="stick"><h2 data-rise>{d.execution.titre}</h2></div>
      <div class="items">{(d.execution.points as string[]).map((x) => <div class="item"><p class="k-pt">{x}</p></div>)}</div>
    </div>
  </section>

  <section class="wrap sec sec-top0">
    <h2 data-rise class="h-gap">{d.appris.titre}</h2>
    <div class="sits k-sits">
      {(d.appris.lecons as Data[]).map((x) => <div class="sit"><p>{x.titre}</p><p class="sit-sub">{x.texte}</p></div>)}
    </div>
  </section>

  <CtaBand titre={d.cloture.titre} texte={d.cloture.texte} />
</Base>
<style>
  .k-date { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin-top: 24px; margin-left: clamp(0px, 24vw, 420px); }
  @media (max-width: 760px) { .k-date { margin-left: 0; } }
  .k-stats { padding-bottom: 80px; }
  .k-h { overflow: hidden; }
  .htrack { display: flex; gap: 24px; padding: 120px var(--gut) 72px; width: max-content; align-items: stretch; }
  .prog { width: min(70vw, 380px); flex: none; background: var(--white); padding: 32px; display: flex; flex-direction: column; justify-content: space-between; min-height: 340px; box-shadow: 0 1px 0 var(--line); }
  .prog.intro { background: transparent; box-shadow: none; justify-content: center; }
  .prog h3 { font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); }
  .prog p { color: var(--ink-2); }
  @media (max-width: 760px) { .k-h { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gut); } .prog { scroll-snap-align: start; } .htrack { padding-top: 40px; } }
  :global(.no-js) .k-h, :global(.rm) .k-h { overflow-x: auto; }
  .k-recit { padding-bottom: 0; }
  .k-big { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.2rem); }
  .k-pt { color: var(--ink); font-size: 1.1rem; }
  .k-sits { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .sit-sub { font-family: var(--read) !important; font-weight: 400 !important; letter-spacing: 0 !important; font-size: 1rem !important; color: var(--ink-2); margin-top: 14px; line-height: 1.6 !important; }
</style>
