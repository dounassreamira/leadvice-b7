---
import Base from '../../layouts/Base.astro';
import SecteurRows from '../../components/SecteurRows.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Image } from 'astro:assets';
import { page, site, type Data } from '../../lib/content';
import { logo } from '../../lib/images';
import '../../styles/pages/levier.css';

const d = await page('realisations');
const chiffresNote = (await site('chiffres')).note as string;
const clients = (await site('clients')).liste as Data[];
const crumb = [{ name: 'Accueil', url: '/' }, { name: d.fil, url: '/realisations/' }];
---
<Base title={d.seo.title} description={d.seo.description} og={d.seo.og} section="rea" crumb={crumb}>
  <PageHero crumb={crumb} h1={d.h1} lead={d.reponse} field="grid" />

  <section class="wrap wall-sec">
    <div class="fil" data-filters="#wall" role="group" aria-label={d.filtres.aria}>
      {(d.filtres.liste as Data[]).map((f, i) => <button type="button" data-f={f.cle} aria-pressed={i === 0 ? 'true' : 'false'}>{f.nom}</button>)}
    </div>
    <ul class="wall" id="wall">
      {clients.map((c) => {
        const inner = (
          <Fragment>
            <div class="lgw"><Image src={logo(c.logo)} alt={c.nom} width={320} format="webp" class="logo-img" loading="lazy" decoding="async" /></div>
            <div class="sr-only">{c.nom}, {c.secteur}{c.mission && <Fragment>. {c.mission}</Fragment>}</div>
          </Fragment>
        );
        return (
          <li class="tile" data-cat={c.filtre}>
            {inner}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="wrap sec sec-top0">
    <h2 data-rise class="h-gap-l">{d.chiffres.titre}</h2>
    <Stats />
    <p class="small stats-note">{chiffresNote}</p>
  </section>

  <section class="wrap sec sec-top0">
    <h2 data-rise class="h-gap">{d.secteurs.titre}</h2>
    <SecteurRows liste={d.secteurs.liste as Data[]} lien={d.secteurs.lien} />
  </section>

  <CtaBand titre={d.cloture.titre} texte={d.cloture.texte} />
</Base>
<style>
  .rea-sect { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .rea-sect a { padding: 26px; display: grid; gap: 10px; align-content: start; text-decoration: none; }
  .rea-sect p { color: var(--ink-2); }
  .rea-sect .tlink { justify-self: start; }
  @media (max-width: 860px) { .rea-sect { grid-template-columns: 1fr; } }
  .wall-sec { padding-bottom: 120px; }
  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .tile { background: var(--white); aspect-ratio: 1 / 1; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .tile-a { display: flex; flex-direction: column; flex: 1; }
  .lgw { flex: 1; display: grid; place-items: center; padding: 24px; }
  .tile img { max-height: 72px; width: auto; max-width: 80%; filter: grayscale(1); opacity: .7; transition: filter .4s, opacity .4s, transform .6s var(--ease); }
  .tile:hover img, .tile-a:focus-visible img { filter: none; opacity: 1; transform: scale(1.06); }
  .tile::after { content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--signal); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); box-shadow: var(--glow); pointer-events: none; }
  .tile:hover::after, .tile:focus-within::after { transform: scaleX(1); }
  .tile-a:focus-visible { outline-offset: -4px; }
  @media (max-width: 900px) { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .case { margin-top: 20px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 40px; align-items: center; background: var(--white); padding: clamp(28px, 4vw, 56px); box-shadow: 0 1px 0 var(--line); }
  .case h2 { font-size: var(--fs-h3); }
  .case-t { color: var(--ink-2); }
  .stats-note { margin-top: 32px; }
  @media (max-width: 820px) { .case { grid-template-columns: 1fr; } }
</style>
<style is:global>
  :root[data-theme="dark"] .wall .tile img { filter: grayscale(1) brightness(0) invert(1); opacity: .75; }
  :root[data-theme="dark"] .wall .tile:hover img { filter: grayscale(1) brightness(0) invert(1); opacity: 1; }
</style>
